# ============================================================
# GISxKMUTNB — .gitignore
# Clean Open-Source AI Repository (Zero Git LFS / 100% Free Forever)
# ============================================================

# Python cache
__pycache__/
*.py[cod]
*.egg-info/
*.egg
.eggs/

# Virtual environments
.venv/
venv/
env/
ENV/

# Build / dist
dist/
build/

# Jupyter
.ipynb_checkpoints/
*.ipynb_checkpoints

# IDE
.vscode/
.idea/
*.suo
*.user

# OS
.DS_Store
Thumbs.db
desktop.ini

# Logs & temp output
logs/
*.log
runs/

# Large Datasets & Model Weights (Kept on local disk / Google Drive / Releases)
data/
checkpoints/
*.pth
*.pt
*.ckpt
*.tif
*.tiff
*.npy
*.npz
*.h5
*.nc
*.aux.xml
